# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clinic_voice_ai?schema=public

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Retell AI
RETELL_API_KEY=
# Set true only for local/dev without signatures. Never in production.
RETELL_SKIP_SIGNATURE_VERIFY=false

# Cliniko
CLINIKO_API_KEY=
CLINIKO_BASE_URL=https://api.au1.cliniko.com/v1
CLINIKO_TIMEOUT=15000
CLINIKO_USER_AGENT=ClinicVoiceAI (ops@example.com)
CLINIKO_DEFAULT_APPOINTMENT_TYPE_ID=
CLINIKO_WEBHOOK_SECRET=
CLINIKO_MAX_ATTEMPTS=5
CLINIKO_BATCH_SIZE=20
CLINIKO_HTTP_MAX_RETRIES=3
CLINIKO_POLL_INTERVAL_MS=30000
# Local only — simulates Cliniko HTTP success without calling the API
CLINIKO_DRY_RUN=false
