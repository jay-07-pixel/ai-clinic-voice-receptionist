# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clinic_voice_ai?schema=public

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Retell AI
RETELL_API_KEY=
# Set true only for local/dev without signatures. Never in production.
RETELL_SKIP_SIGNATURE_VERIFY=false
